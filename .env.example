# Copy to .env and fill in. Never commit .env.

# Web address the app runs on (point this domain's DNS A record at the server first).
DOMAIN=erp.example.com

# First main login. Only used on the very first start, when the database is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
ADMIN_PASSWORD=change-this-to-a-long-password

# Password given to demo staff if "Load demo data" is chosen (leave as is for real use; don't load demo data in production).
DEMO_PASSWORD=imperial-demo

# Daily database backups kept in the data volume (days).
BACKUP_KEEP=14
